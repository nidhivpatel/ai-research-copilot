# LLM Backend (vLLM on Scaleway or OpenAI)
LLM_BASE_URL=http://<SCALEWAY_IP>:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Firecrawl (get free key at firecrawl.dev, or leave empty for httpx fallback)
FIRECRAWL_API_KEY=fc-...

# Langfuse (self-hosted via docker-compose)
LANGFUSE_PUBLIC_KEY=lf_pk_1234567890
LANGFUSE_SECRET_KEY=lf_sk_1234567890
LANGFUSE_HOST=http://localhost:3001
